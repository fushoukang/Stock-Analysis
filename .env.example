# Alpaca API credentials
# Get keys at https://app.alpaca.markets/ (paper) or https://app.alpaca.markets/live (live)
ALPACA_API_KEY="your_api_key_here"
ALPACA_SECRET_KEY="your_secret_key_here"

# Set to "true" for paper trading keys, "false" for a live account.
# NOTE: this app is read-only market-data analysis and never places orders,
# regardless of this setting. It only affects which key pair / trading
# endpoint the TradingClient (account info) points to.
ALPACA_PAPER=true

# Data feed: "iex" (free) or "sip" (paid, full market)
ALPACA_DATA_FEED=iex

# Comma-separated watchlist. Alpaca only trades/streams equities and ETFs,
# not raw index tickers, so these are the standard ETF proxies for the major
# US market indexes: SPY = S&P 500, QQQ = Nasdaq-100, DIA = Dow Jones
# Industrial Average, IWM = Russell 2000.
WATCHLIST=SPY,QQQ,DIA,IWM

# Comma-separated crypto pairs for the "Focus Crypto Analysis" page (uses
# the same Alpaca account credentials above — Alpaca just runs a separate
# crypto exchange/data path). BASE/QUOTE format, e.g. BTC/USDT, ETH/USDT.
# Unlike WATCHLIST, crypto trades 24/7 so this isn't gated by market hours.
CRYPTO_WATCHLIST=BTC/USDT,ETH/USDT

# SQLite DB file path (relative to project root)
DB_PATH=data_store.db
# Days of raw 1-min bars to keep before a periodic background job prunes
# older rows (every 6 hours) — otherwise the bars table only ever grows.
# Keep this well above the KDJ monitor's 5-day lookback need.
BAR_RETENTION_DAYS=30

# JSON file storing the GUI's named Watchlists (name + note + symbols each) —
# not the same as WATCHLIST above, which is just the default streamed symbols.
WATCHLISTS_PATH=watchlists.json
# Directory holding each account's own private copy of the Watchlists page's
# lists — one file per user, seeded from WATCHLISTS_PATH above the first
# time they touch it, then independent from it and from every other
# account. You normally don't need to change this.
# USER_WATCHLISTS_DIR=data/user_watchlists

# Web server
# "auto" detects this machine's LAN IPv4 address at startup, so the GUI is
# reachable from other devices on your network without a hardcoded address.
# Set to 127.0.0.1 for local-only access, or a specific IP to pin it.
HOST=auto
PORT=8000

# --- Market data window ---
# Alpaca (both the WebSocket live stream and REST catch-up/backfill calls) is
# only ever contacted during this window — early + regular + post market
# trading hours. Outside it the app makes zero Alpaca API calls and the GUI
# shows "The market has closed" instead. Times are ET, 24-hour HH:MM.
MARKET_DATA_START_ET=06:30
MARKET_DATA_END_ET=18:00

# --- KDJ cross alerting ---
# File of symbols to watch for a KDJ K/D cross (space/comma/newline separated).
MONITOR_LIST_PATH=monitor_list.txt
# Directory holding each account's own private copy of the Focus Stock
# Analysis page's Symbol list — one file per user, seeded from
# MONITOR_LIST_PATH above the first time they touch it, then independent
# from it and from every other account. The background KDJ monitor now
# watches the union of every account's own list, and emails each detected
# cross only to the account(s) actually watching that symbol. You normally
# don't need to change this.
# USER_MONITOR_LISTS_DIR=data/user_monitor_lists
# How often (seconds) to recompute KDJ and check for a fresh cross.
KDJ_CHECK_INTERVAL_SEC=120
# How fresh (minutes) the raw market data must be for a cross to be alerted
# on. Wider than the check interval so thinner symbols on the free IEX feed
# (fewer trades/minute) still get alerted instead of being suppressed just
# because the feed hasn't ticked very recently.
KDJ_FRESHNESS_WINDOW_MIN=5
# Master on/off switch for KDJ cross email alerts. The monitor keeps running
# and detecting crosses (and the on-screen WebSocket alert in the GUI keeps
# firing) either way — set to false to silence just the emails.
KDJ_EMAIL_ALERTS_ENABLED=false

# SMTP credentials used to send the alert email. Example for Gmail:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
#   SMTP_PASSWORD=<an App Password from https://myaccount.google.com/apppasswords
#   — NOT your normal Gmail password; regular passwords are rejected by Gmail's
#   SMTP for security>. Any other SMTP provider (Outlook, a transactional
#   email service, etc.) works the same way — just swap host/port/credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDRESS=your_email@gmail.com

# Email address that gets the KDJ cross alert.
ALERT_EMAIL_TO=mail@exmaple.com

# --- Crypto KDJ cross alerting (Focus Crypto Analysis page) ---
# Comma-separated crypto pairs to watch for a KDJ K/D cross, independent of
# MONITOR_LIST_PATH above (which only ever holds stock tickers). Runs 24/7,
# unlike the stock monitor, since crypto has no market-closed window. Pairs
# listed here should also be in CRYPTO_WATCHLIST so there's live data to check.
CRYPTO_KDJ_MONITOR_SYMBOLS=BTC/USDT
# Separate on/off switch from KDJ_EMAIL_ALERTS_ENABLED above, so silencing
# stock alert emails doesn't also silence crypto ones (or vice versa). Uses
# the same SMTP credentials and ALERT_EMAIL_TO address as the stock monitor.
CRYPTO_KDJ_EMAIL_ALERTS_ENABLED=true

# --- Web GUI authentication ---
# Named accounts (email + password) gate the entire web GUI — every page,
# API route, and the live WebSocket. Two ways to get one:
#   - Self-service: the public /signup page, gated by REGISTRATION_CODE
#     below (share that code with whoever you want to have access) plus a
#     required "click the link we emailed you" verification step — so
#     SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD (further down in this file)
#     must also be set, or /signup stays disabled.
#   - You, directly: `python manage_users.py add <email>` — pre-verified,
#     no email round trip needed.
# Until at least one account exists (or signup is enabled), the GUI stays
# locked — there's no "unauthenticated" fallback.
USERS_PATH=users.json
REGISTRATION_CODE=
# Optional: hand different groups of people their own code instead of (or
# in addition to) the one above — any number of REGISTRATION_CODE_<GROUP>
# vars. The <GROUP> part becomes a label stored on the account (upper-cased)
# purely for your own bookkeeping — see `python manage_users.py list` —
# everyone still gets identical access once signed up, whichever code they
# used. Example:
#   REGISTRATION_CODE_FAMILY=some-secret-for-family
#   REGISTRATION_CODE_FRIENDS=some-secret-for-friends
# A "GUEST" code is treated specially: if set, the /signup page shows it
# directly to visitors ("New here? Enter 0000 for guest access") instead of
# expecting them to already know a code — meant for a deliberately public,
# low-friction default rather than one you hand out privately. Leave unset
# for no public guest signup.
#   REGISTRATION_CODE_GUEST=0000
# Signs the login session cookie. Optional — if unset, a random key is
# generated each time the app starts (everyone gets logged out on restart).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
# How many hours a login stays valid before you have to sign in again.
SESSION_MAX_AGE_HOURS=168
# Set to true once served over real HTTPS (see deploy/README.md). Leave
# false for a plain-HTTP LAN deployment — a Secure cookie is silently
# dropped by the browser over plain HTTP, which breaks login.
SESSION_COOKIE_SECURE=false
# How many hours a signup's "click to verify your email" link stays valid.
VERIFICATION_TOKEN_MAX_AGE_HOURS=24
# How many hours a "reset your password" email link stays valid — shorter
# than VERIFICATION_TOKEN_MAX_AGE_HOURS by design, since it hands over the
# account rather than just proving you control the mailbox.
RESET_TOKEN_MAX_AGE_HOURS=1

# Comma-separated email(s) allowed to reach the /admin/users page in the
# GUI (view every account, delete one). Leave empty and nobody can reach
# it, even if logged in — being able to sign in doesn't by itself grant
# the ability to manage other people's accounts. Example:
#   ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=
