__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets — never commit real Alpaca/SMTP credentials
.env

# OS cruft
.DS_Store

# IDE settings
.idea/

# Local SQLite bar cache (regenerated on startup via backfill)
data_store.db

